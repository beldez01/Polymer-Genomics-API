# ──────────────────────────────────────────────────────────────────
# Polymer Genomics API — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy to .env:  cp .env.example .env

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polymer_genomics
POSTGRES_USER=api_reader
POSTGRES_USER_PASSWORD=api_reader_dev
POSTGRES_ADMIN_USER=admin

# ── S3 / MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_BUCKET=polymer-genomics-api
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── API Server ────────────────────────────────────────────────────
# Leave POLYMER_API_KEY blank for local dev (open access).
# Set for deployed instances: openssl rand -hex 32
POLYMER_API_KEY=
POLYMER_CORS_ORIGINS=http://localhost:3000

# ── Data Paths ────────────────────────────────────────────────────
FASTA_DIR=data
# FASTA_HG38=data/hg38.fa
# FASTA_HG37=data/hg37.fa

# ── Tuning ──────────────────────────────────────────────────────
MAX_REGION_LENGTH=10000000
MAX_RETURNED_ROWS=50000
DEFAULT_PAGE_SIZE=1000

# ── Viewer ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Ingest Configuration ──────────────────────────────────────────
# Set POLYMER_ENV=production to refuse fallback dev credentials
# POLYMER_ENV=production

# Database credentials for ingest_writer role (non-admin data loading)
# POSTGRES_USER_PASSWORD=changeme

# Polymer Evolution phase output directories (used by biophysics ingest)
# POLYMER_EVOLUTION_PHASE1_DIR=/path/to/Polymer_Evolution/phase1/output/window_1000
# POLYMER_EVOLUTION_PHASE2_DIR=/path/to/Polymer_Evolution/phase2/output/window_1000
# POLYMER_EVOLUTION_PHASE3_5_DIR=/path/to/Polymer_Evolution/phase3_5/output/window_1000

# Research data root (conservation, repeats, regulatory, etc.)
# RESEARCH_DATA_DIR=/path/to/Research/data

# Reference genome FASTA
# FASTA_HG38=/path/to/hg38.fa

# Conservation BigWig files
# PHYLOP_BW=/path/to/hg38.phyloP100way.bw
# PHASTCONS_BW=/path/to/hg38.phastCons100way.bw

# GTEx expression data
# GTEX_MEDIAN_TPM=/path/to/GTEx_Analysis_v10_gene_median_tpm.gct.gz
